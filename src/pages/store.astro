---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import { products } from '../data/site.js';
---

<Base title="Store — themed1c">
  <h1 class="h1 h1--sub">Store</h1>
  <p class="kicker">kits</p>

  <div class="grid-2 store">
    {
      products.map((product) => (
        <figure>
          <Cover
            src={product.cover}
            alt={product.alt}
            href={product.href}
            label={product.href ? `Open ${product.title} on Sellfy` : undefined}
          />
          <figcaption class="product__caption">
            {product.href ? (
              <a
                class="product__title"
                href={product.href}
                target="_blank"
                rel="noreferrer noopener"
              >
                {product.title} <span class="arrow">↗</span>
              </a>
            ) : (
              <span class="product__title">{product.title}</span>
            )}
            {product.status && <span class="product__status">{product.status}</span>}
          </figcaption>
        </figure>
      ))
    }
  </div>

  <h2 class="label label--section">Want my melodies? :)</h2>

  <form class="melody-form" data-melody-form>
    <input type="email" required placeholder="your@email.com" aria-label="Email address" />
    <input
      class="melody-form__honeypot"
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />
    <button type="submit">Submit</button>
  </form>
</Base>

<script>
  import { initMelodyForm } from '../scripts/melody-form.js';
  initMelodyForm();
</script>
