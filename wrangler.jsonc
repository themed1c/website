{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "dist/_worker.js/index.js",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "themed1c.com", "custom_domain": true },
    { "pattern": "www.themed1c.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  // The @astrojs/cloudflare adapter auto-enables KV sessions for the
  // on-demand /api/subscribe route and expects this binding to exist.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "0dcd9c3cd9ba49da8757092e6d956e35"
    }
  ],
  "observability": {
    "enabled": true
  }
}
