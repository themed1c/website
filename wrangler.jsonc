{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "dist/_worker.js/index.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "themed1c.com", "custom_domain": true },
    { "pattern": "www.themed1c.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "observability": {
    "enabled": true
  }
}
